{
  "name": "vul-tools",
  "displayName": "VUL Tools",
  "description": "VUL declaration checking and read-only component visualization for VS Code.",
  "version": "0.1.0",
  "publisher": "mengcz-sdu",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "VUL",
    "hardware",
    "modeling"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and visualization work; external build commands require a trusted workspace."
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onCustomEditor:vul-tools.visualizer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vul",
        "aliases": [
          "VUL"
        ],
        "extensions": [
          ".vul"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vul-testbench",
        "aliases": [
          "VUL Testbench"
        ],
        "extensions": [
          ".utb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vul",
        "scopeName": "source.vul",
        "path": "./syntaxes/vul.tmLanguage.json"
      },
      {
        "language": "vul-testbench",
        "scopeName": "source.vul.testbench",
        "path": "./syntaxes/vul-testbench.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "vul-tools.visualizer",
        "displayName": "VUL Tools Visual View",
        "selector": [
          {
            "filenamePattern": "*.vul"
          },
          {
            "filenamePattern": "*.uh"
          },
          {
            "filenamePattern": "*.utb"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vul-tools.openVisual",
        "title": "VUL Tools: Open Visual View",
        "icon": "$(preview)"
      },
      {
        "command": "vul-tools.openSource",
        "title": "VUL Tools: Open Source View",
        "icon": "$(code)"
      },
      {
        "command": "vul-tools.refresh",
        "title": "VUL Tools: Refresh Declarations",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vul-tools.openVisual",
          "when": "(resourceExtname == .vul || resourceExtname == .uh || resourceExtname == .utb) && activeCustomEditorId != vul-tools.visualizer",
          "group": "navigation"
        },
        {
          "command": "vul-tools.openSource",
          "when": "activeCustomEditorId == vul-tools.visualizer",
          "group": "navigation"
        },
        {
          "command": "vul-tools.refresh",
          "when": "(resourceExtname == .vul || resourceExtname == .uh || resourceExtname == .utb)",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VUL Tools",
      "properties": {
        "vulTools.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check VUL declaration syntax. C++ bodies are not checked."
        },
        "vulTools.projectRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Project directory override. Relative paths use the workspace folder. If empty, use the module PROJECT declaration, then search ancestor directories for a project Header."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p . && node scripts/build.cjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.cjs",
    "test:host": "npm run build && node scripts/test-host.cjs",
    "test:examples": "node scripts/test-examples.cjs",
    "package": "vsce package --no-dependencies",
    "example": "node scripts/build-example.cjs",
    "test:webview": "npm run build && node scripts/test-webview.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meng-cz/vultools.git"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
